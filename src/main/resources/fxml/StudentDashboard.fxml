<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.controllers.StudentDashboardController">

    <top>
        <HBox alignment="CENTER">
        <Label style="-fx-font-size:24px; -fx-padding:10" text="Student/Staff Dashboard" BorderPane.alignment="CENTER" />
         </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane">

            <!-- Available Books -->
            <Tab closable="false" onSelectionChanged="#handleTabSelection" text="Available Books">
                <content>
                    <BorderPane>
                        <right>
                            <VBox alignment="TOP_CENTER" minWidth="100.0" prefHeight="450.0" prefWidth="225.0" style="-fx-background-color: white; -fx-border-color: lightgrey;" BorderPane.alignment="CENTER_RIGHT">
                                <BorderPane.margin>
                                    <Insets left="15.0" />
                                </BorderPane.margin>
                                <children>
                                    <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="303.0" style="-fx-background-color: linear-gradient(to bottom, #eeeeee, #dcdcdc); -fx-text-fill: black;-fx-border-color: #cfcfcf;-fx-border-width: 1;" text="Description" HBox.hgrow="ALWAYS">
                                        <font>
                                            <Font size="14.0" />
                                        </font>
                                        <padding>
                                            <Insets bottom="8" left="8" right="8" top="8" />
                                        </padding>
                                    </Label>
                                    <Button fx:id="borrowBookButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleBorrowSelectedBook" prefHeight="26.0" prefWidth="138.0" text="Borrow Selected Book" textAlignment="CENTER">
                                        <VBox.margin>
                                            <Insets bottom="20.0" top="20.0" />
                                        </VBox.margin>
                                    </Button>
                                    <Label alignment="TOP_LEFT" prefWidth="203.0" style="-fx-font-weight: bold;" text="Book Details" underline="true">
                                        <VBox.margin>
                                            <Insets bottom="5.0" />
                                        </VBox.margin>
                                    </Label>
                                    <Label alignment="TOP_LEFT" prefWidth="203.0" style="-fx-font-weight: bold;" text="Title:" />
                                    <Label fx:id="tab1_TitleLabel" alignment="TOP_LEFT" minHeight="20.0" prefWidth="203.0">
                                        <VBox.margin>
                                            <Insets bottom="10.0" />
                                        </VBox.margin>
                                    </Label>
                                    <Label alignment="TOP_LEFT" prefWidth="203.0" style="-fx-font-weight: bold;" text="Author:" />
                                    <Label fx:id="tab1_AuthorLabel" alignment="TOP_LEFT" minHeight="20.0" prefWidth="203.0">
                                        <VBox.margin>
                                            <Insets bottom="10.0" />
                                        </VBox.margin>
                                    </Label>
                                    <Label alignment="TOP_LEFT" prefWidth="203.0" style="-fx-font-weight: bold;" text="Published on" />
                                    <Label fx:id="tab1_PublishedOnLabel" alignment="TOP_LEFT" minHeight="20.0" prefWidth="203.0">
                                        <VBox.margin>
                                            <Insets bottom="10.0" />
                                        </VBox.margin>
                                    </Label>
                                    <Label alignment="TOP_LEFT" prefWidth="203.0" style="-fx-font-weight: bold;" text="Abstract" />
                                    <Label fx:id="tab1_AbstractLabel" alignment="TOP_LEFT" minHeight="20.0" prefWidth="203.0">
                                        <VBox.margin>
                                            <Insets bottom="10.0" />
                                        </VBox.margin>
                                    </Label>
                                </children>
                            </VBox>
                        </right>
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <center>
                            <TableView fx:id="availableBooksTable" prefHeight="450.0" prefWidth="537.0" style="-fx-border-color: lightgrey;" BorderPane.alignment="CENTER_LEFT">
                                <columns>
                                    <TableColumn fx:id="tab1_TitleCol" editable="false" minWidth="100.0" prefWidth="100.0" style="-fx-text-fill: black;" text="Title" />
                                    <TableColumn fx:id="tab1_AuthorCol" editable="false" minWidth="100.0" prefWidth="100.0" text="Author" />
                                    <TableColumn fx:id="tab1_PublishedOnCol" editable="false" minWidth="100.0" prefWidth="100.0" text="Published On" />
                                    <TableColumn fx:id="tab1_AbstractCol" editable="false" minWidth="100.0" prefWidth="200.0" text="Abstract" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                </padding>
                            </TableView>
                        </center>
                    </BorderPane>
                </content></Tab>

            <!-- My Borrowed Books -->
            <Tab closable="false" onSelectionChanged="#handleTabSelection" text="My Borrowed Books">
                <content>
                    <BorderPane>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </padding>
                        <center>
                            <TableView fx:id="myBorrowedBooksTable" prefHeight="386.0" prefWidth="790.0" style="-fx-border-color: lightgrey;" BorderPane.alignment="CENTER_LEFT">
                                <columns>
                                    <TableColumn fx:id="tab2_TitleCol" editable="false" minWidth="100.0" prefWidth="150.0" text="Title" />
                                    <TableColumn fx:id="tab2_AuthorCol" editable="false" minWidth="64.0" prefWidth="150.0" text="Author" />
                                    <TableColumn fx:id="tab2_BorrowedOnCol" editable="false" minWidth="100.0" prefWidth="200.0" text="Borrowed On" />
                                    <TableColumn fx:id="tab2_TimeLeftCol" editable="false" minWidth="100.0" prefWidth="200.0" text="Time Left" />
                                    <TableColumn fx:id="tab2_ActionsCol" editable="false" minWidth="100.0" prefWidth="120.0" text="Actions" />
                                </columns>
                                <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                </padding>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </center>
                        <bottom>
                            <Button fx:id="readBookButton" mnemonicParsing="false" onAction="#handleReadBook" prefHeight="41.0" prefWidth="140.0" text="Read Selected Book" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets bottom="20.0" top="20.0" />
                                </BorderPane.margin>
                            </Button>
                        </bottom>
                    </BorderPane>
                </content></Tab>

            <!-- Update Account -->
            <Tab fx:id="profileTab" onSelectionChanged="#handleTabSelection" text="My Profile">
                <content>
                    <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;">
                        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Update Profile" />

                        <GridPane alignment="CENTER" hgap="15" style="-fx-padding: 10;" vgap="15">
                            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            </Label>

                            <Label text="Full Name:" GridPane.rowIndex="1">
                                <tooltip>
                                    <Tooltip text="Length must be 2 to 50 characters." />
                                </tooltip>
                            </Label>
                            <TextField onAction="#handleProfileUpdate" fx:id="fullNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Password:" GridPane.rowIndex="2">
                                <tooltip>
                                    <Tooltip text="Must be at least 8 characters long and include numbers, uppercase and lowercase letters." />
                                </tooltip>
                            </Label>
                            <PasswordField onAction="#handleProfileUpdate" fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <TextField onAction="#handleProfileUpdate" fx:id="passwordTextField" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <ToggleButton fx:id="viewPasswordBtn" maxHeight="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#handleViewPassword" prefWidth="50.0" text="Show" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <Label text="Confirm Password:" GridPane.rowIndex="3" />
                            <PasswordField onAction="#handleProfileUpdate" fx:id="confirmPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <TextField onAction="#handleProfileUpdate" fx:id="confirmPasswordTextField" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <ToggleButton fx:id="viewConfirmPasswordBtn" minWidth="50.0" mnemonicParsing="false" onAction="#handleViewConfirmPassword" prefWidth="50.0" text="Show" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                            <Text fx:id="usernameText" strokeType="OUTSIDE" strokeWidth="0.0" GridPane.columnIndex="1" />
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" />
                                <ColumnConstraints />
                                <ColumnConstraints minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>

                        <Button onAction="#handleProfileUpdate" style="-fx-pref-width: 120; -fx-pref-height: 35;" text="Update Profile" />

                        <Label fx:id="toastLabel" style="-fx-text-fill: red; -fx-font-size: 14px; -fx-alignment: center;" visible="false" />
                    </VBox>
                </content>
            </Tab>

            <!-- Inform Board -->
            <Tab closable="false" onSelectionChanged="#handleTabSelection" text="Inform Board">
                <content>
                    <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                        <children>
                            <Label fx:id="notificationLabel" />
                            <ListView fx:id="notificationList" prefHeight="300.0" prefWidth="780.0" style="-fx-background-color: #fafafa;" VBox.vgrow="ALWAYS" />
                            <Button fx:id="clearAllButton" mnemonicParsing="false" onAction="#handleClearAllNotifications" prefHeight="33.0" prefWidth="96.0" text="Clear ALL" />
                        </children>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding></VBox>
                </content></Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#handleLogout" prefHeight="40" prefWidth="150" text="Logout" />
        </HBox>
    </bottom>
</BorderPane>
